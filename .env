# =========================================================================
# MELIA HOTEL TTCSN - DOCKER ENVIRONMENT CONFIGURATION
# =========================================================================
# Cổng mở ra ngoài máy host (Không xung đột với các dự án khác trên Docker)
FRONTEND_PORT=3001
BACKEND_PORT=8088
MYSQL_PORT=3306

# Môi trường Database mặc định (h2: siêu nhẹ độc lập, hoặc mysql: kèm database MySQL)
SPRING_PROFILES_ACTIVE=h2
